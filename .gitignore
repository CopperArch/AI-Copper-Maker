imagegen_local_state.json

# Downloaded model weights (huihui-ai/, and any other org/repo-style download
# dir a Hugging Face / ModelScope pull lands in at repo root) — multi-GB
# binary weights don't belong in git history.
huihui-ai/
*.gguf
*.safetensors
backend/trainer.db
backend/trainer.db-*

